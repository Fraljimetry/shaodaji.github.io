{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaodaji.cc/mathillustrator/docs/schemas/project-v1.schema.json",
  "title": "MathIllustrator semantic project v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "meta",
    "settings",
    "objects",
    "nextId"
  ],
  "properties": {
    "format": {
      "const": "mathillustrator-project"
    },
    "version": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "nextId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "objects": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "coord": {
      "type": "number",
      "exclusiveMinimum": -1000000000,
      "exclusiveMaximum": 1000000000
    },
    "xy": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coord"
        },
        {
          "$ref": "#/$defs/coord"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "style": {
      "type": "object",
      "required": [
        "stroke",
        "fill",
        "width",
        "opacity"
      ],
      "properties": {
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pointSize": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "description": "Optional per-point radius in CSS px; valid only for point/midpoint/intersection/circleIntersection objects. Older v1 objects may omit it; while untouched they display the current legacy pointSize default. When the user changes the new-object point-size default, MathIllustrator first pins those existing objects to their prior displayed radius using this optional field, preserving appearance."
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "grid",
        "snap",
        "snapStep",
        "correction",
        "showAxes",
        "stroke",
        "fill",
        "opacity",
        "width",
        "pointSize",
        "page",
        "background"
      ],
      "properties": {
        "grid": {
          "type": "boolean"
        },
        "snap": {
          "type": "boolean"
        },
        "snapStep": {
          "type": "number",
          "maximum": 1000,
          "minimum": 1e-06,
          "description": "1e-6 through 1000 world units: lower legacy values now explicitly rejected because they can overflow floating-point snapping."
        },
        "correction": {
          "enum": [
            "off",
            "gentle",
            "medium",
            "strong",
            "ultra"
          ]
        },
        "showAxes": {
          "type": "boolean"
        },
        "stroke": {
          "$ref": "#/$defs/color"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "pointSize": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "page": {
          "enum": [
            "infinite",
            "a4",
            "a3",
            "a5",
            "letter",
            "legal",
            "tabloid",
            "square",
            "widescreen"
          ]
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "exportRegion": {
          "enum": [
            "viewport",
            "page"
          ]
        },
        "showLabels": {
          "type": "boolean"
        },
        "labelPlacement": {
          "enum": [
            "standard",
            "avoid"
          ],
          "description": "Optional v1 visual layout preference. Standard preserves historical pixel placement; avoid repositions point name labels without changing text or coordinates."
        },
        "snapAnchors": {
          "type": "boolean"
        },
        "modules": {
          "type": "object",
          "required": [
            "basic",
            "construction",
            "illustration",
            "diagram"
          ],
          "properties": {
            "basic": {
              "type": "boolean"
            },
            "construction": {
              "type": "boolean"
            },
            "illustration": {
              "type": "boolean"
            },
            "diagram": {
              "type": "boolean"
            }
          }
        },
        "polygonSides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 100,
          "description": "Default side count for newly drawn regular polygons; optional for legacy v1 documents, default 6."
        },
        "exportGuides": {
          "type": "boolean",
          "description": "Optional v1; defaults to false. When enabled, image exports include visible grid and axes; never exports the editor page outline."
        },
        "exportScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Optional v1; defaults to 2. PNG/JPEG/WebP pixel-resolution multiplier (not calibrated DPI)."
        },
        "plotQuality": {
          "enum": [
            "fast",
            "balanced",
            "detailed"
          ],
          "description": "Optional v1 extension; missing means balanced. Analysis / plots preset selects detailed. Higher detail costs CPU and is never an exact plotting proof."
        },
        "exportTransparent": {
          "type": "boolean",
          "description": "Optional v1 extension; false if absent. Alpha-preserving SVG/PNG/WebP only; JPEG option disabled if true; editor background unchanged."
        },
        "namingConvention": {
          "enum": [
            "pascal",
            "camel",
            "snake"
          ],
          "description": "Optional v1 display-name convention for newly created objects. New projects use pascal; legacy projects missing this field remain camel. Existing names and IDs are never modified."
        },
        "freehandClose": {
          "type": "string",
          "enum": [
            "open",
            "near",
            "always"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "page": {
                "const": "infinite"
              }
            },
            "required": [
              "page"
            ]
          },
          "then": {
            "properties": {
              "exportRegion": {
                "not": {
                  "const": "page"
                }
              }
            }
          }
        }
      ]
    },
    "object": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "style",
        "hidden",
        "locked"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^o[1-9][0-9]*$",
          "maxLength": 17
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        "type": {
          "enum": [
            "point",
            "midpoint",
            "segment",
            "arrow",
            "line",
            "circle",
            "ellipse",
            "rectangle",
            "parallelogram",
            "polygon",
            "polyline",
            "bezier",
            "angle",
            "freehand",
            "text",
            "function",
            "node",
            "morphism",
            "regularPolygon",
            "ray",
            "perpBisector",
            "circleThrough3",
            "spline",
            "parallelThrough",
            "perpendicularThrough",
            "intersection",
            "circleIntersection",
            "circleCircleIntersection"
          ]
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "hidden": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "xy": {
          "$ref": "#/$defs/xy"
        },
        "edgeOf": {
          "type": "string",
          "pattern": "^o[1-9][0-9]*$",
          "description": "Owner of an independently editable segment: free-vertex polygon, rectangle, or regular polygon. Ownership is validated by the model."
        },
        "edgeIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99,
          "description": "Optional derived-side ordinal (0-based) for rectangle or regular-polygon owned segments. Referenced anchors are the owner's defining anchors; endpoints are computed live. Both owner and index are cross-validated by the model."
        },
        "branch": {
          "type": "integer",
          "enum": [
            -1,
            1
          ],
          "description": "Signed root along the oriented straight object for dynamic line-circle intersections."
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^o[1-9][0-9]*$"
          },
          "maxItems": 2000,
          "description": "Existing v1 point-anchored objects reference points/midpoints/intersections. Round25 parallelThrough/perpendicularThrough require [point reference, straight-line object reference]; intersection requires two straight objects. Round26 circleIntersection requires [straight object reference, circle reference] and signed branch ±1. Straight sources include segment, arrow, line, ray, perpBisector and the new through-point lines. References are stable IDs, validated for target type, acyclicity and live geometry in the model."
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xy"
          },
          "minItems": 2,
          "maxItems": 20000
        },
        "text": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        "fontSize": {
          "type": "number",
          "minimum": 5,
          "maximum": 200
        },
        "expr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "bend": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "swap": {
          "type": "boolean"
        },
        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 100
        },
        "routing": {
          "type": "string",
          "enum": [
            "direct",
            "avoid",
            "avoid-crossings",
            "scene-crossings"
          ],
          "description": "Optional morphism-only routing. Legacy absent value means direct/curved. Avoid uses best-effort two-turn screen-space routing around visible nodes. Avoid-crossings additionally prioritizes fewer interior crossings with earlier visible arrows, subject to bounded search/inspection; unresolved crossings are warned. Neither changes semantic refs."
        },
        "labelT": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95,
          "description": "Optional morphism-only label fraction along arrow (default 0.5)."
        },
        "labelDistance": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "description": "Optional morphism-only perpendicular label distance in CSS px (default 17)."
        },
        "labelDx": {
          "type": "number",
          "minimum": -300,
          "maximum": 300,
          "description": "Optional morphism-only horizontal label shift in CSS px (default 0)."
        },
        "labelDy": {
          "type": "number",
          "minimum": -300,
          "maximum": 300,
          "description": "Optional morphism-only vertical label shift in CSS px (default 0)."
        },
        "labelAvoid": {
          "type": "boolean",
          "description": "Optional morphism-only best-effort collision avoidance for screen-space label display; default false for legacy projects. Does not mutate semantic edges, labels, node coordinates or author-selected offsets. Manual handle dragging disables auto placement."
        },
        "nodeBorder": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        },
        "joinStyle": {
          "type": "string",
          "enum": [
            "corner",
            "smooth"
          ],
          "description": "Optional freehand-only v1 extension, valid only with closed=true. Omission retains legacy cyclic closure."
        },
        "arrowStyle": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "hook",
            "hook-dashed",
            "twohead",
            "tail"
          ]
        },
        "textMode": {
          "type": "string",
          "enum": [
            "plain",
            "latex"
          ],
          "description": "Optional type/node/morphism label rendering. Absence retains historical plain text."
        },
        "fontFamily": {
          "type": "string",
          "enum": [
            "Georgia, serif",
            "Arial, sans-serif",
            "Consolas, monospace",
            "Verdana, sans-serif",
            "Trebuchet MS, sans-serif",
            "Palatino Linotype, serif",
            "Times New Roman, serif"
          ],
          "description": "Optional plain-text font; mathematical SVG uses its bundled mathematical glyphs."
        },
        "displayLabel": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional displayed label for geometric objects, separate from their stable semantic names."
        },
        "displayLabelMode": {
          "type": "string",
          "enum": [
            "plain",
            "latex"
          ],
          "description": "Optional mathematical label mode for geometric objects."
        },
        "pointLabel": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional point/midpoint display label, separate from the immutable reference name."
        },
        "pointLabelMode": {
          "type": "string",
          "enum": [
            "plain",
            "latex"
          ],
          "description": "Optional point/midpoint label math renderer. Absence means legacy plain text."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "edgeIndex"
            ]
          },
          "then": {
            "required": [
              "edgeOf"
            ],
            "properties": {
              "type": {
                "const": "segment"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "edgeOf"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "segment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "point"
              }
            }
          },
          "then": {
            "required": [
              "xy"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "node"
              }
            }
          },
          "then": {
            "required": [
              "xy",
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "xy",
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "circleCircleIntersection"
              }
            }
          },
          "then": {
            "required": [
              "refs",
              "branch"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              },
              "branch": {
                "enum": [
                  -1,
                  1
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "circleIntersection"
              }
            }
          },
          "then": {
            "required": [
              "refs",
              "branch"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              },
              "branch": {
                "enum": [
                  -1,
                  1
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "midpoint"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "segment"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "edgeIndex"
                  ]
                },
                "then": {
                  "properties": {
                    "refs": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3
                    }
                  }
                },
                "else": {
                  "properties": {
                    "refs": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "arrow"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "line"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "circle"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ellipse"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bezier"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "angle"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "morphism"
              }
            }
          },
          "then": {
            "required": [
              "refs",
              "text"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "polygon"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "minItems": 3,
                "maxItems": 2000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "polyline"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "minItems": 2,
                "maxItems": 2000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "freehand"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "function"
              }
            }
          },
          "then": {
            "required": [
              "expr"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "regularPolygon"
              }
            }
          },
          "then": {
            "required": [
              "refs",
              "sides"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rectangle"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "parallelogram"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "not": {
                  "const": "morphism"
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "routing"
                  ]
                },
                {
                  "required": [
                    "labelT"
                  ]
                },
                {
                  "required": [
                    "labelDistance"
                  ]
                },
                {
                  "required": [
                    "labelDx"
                  ]
                },
                {
                  "required": [
                    "labelDy"
                  ]
                },
                {
                  "required": [
                    "labelAvoid"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ray"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "perpBisector"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "circleThrough3"
              }
            }
          },
          "then": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "spline"
              }
            }
          },
